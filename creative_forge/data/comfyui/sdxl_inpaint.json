{
  "1": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "$checkpoint"}, "_meta": {"title": "SDXL checkpoint"}},
  "2": {"class_type": "LoadImage", "inputs": {"image": "$image"}, "_meta": {"title": "Frame (uploaded to temp)"}},
  "3": {"class_type": "CLIPTextEncode", "inputs": {"text": "$prompt", "clip": ["1", 1]}, "_meta": {"title": "Positive"}},
  "4": {"class_type": "CLIPTextEncode", "inputs": {"text": "$negative_prompt", "clip": ["1", 1]}, "_meta": {"title": "Negative"}},
  "5": {"class_type": "VAEEncode", "inputs": {"pixels": ["2", 0], "vae": ["1", 2]}, "_meta": {"title": "Encode frame"}},
  "9": {"class_type": "LoadImageMask", "inputs": {"image": "$mask", "channel": "red"}, "_meta": {"title": "Edit mask (white = may change)"}},
  "10": {"class_type": "SetLatentNoiseMask", "inputs": {"samples": ["5", 0], "mask": ["9", 0]}, "_meta": {"title": "Noise only inside the mask"}},
  "6": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "$seed", "steps": "$steps", "cfg": "$cfg", "sampler_name": "$sampler", "scheduler": "$scheduler",
      "denoise": "$denoise", "model": ["1", 0], "positive": ["3", 0], "negative": ["4", 0], "latent_image": ["10", 0]
    },
    "_meta": {"title": "Sampler"}
  },
  "7": {"class_type": "VAEDecode", "inputs": {"samples": ["6", 0], "vae": ["1", 2]}, "_meta": {"title": "Decode"}},
  "8": {"class_type": "PreviewImage", "inputs": {"images": ["7", 0]}, "_meta": {"title": "Result (temp, not output/)"}}
}
