{
  "1": {"class_type": "UNETLoader", "inputs": {"unet_name": "$diffusion_model", "weight_dtype": "default"}, "_meta": {"title": "Wan 2.2 TI2V 5B"}},
  "2": {"class_type": "CLIPLoader", "inputs": {"clip_name": "$text_encoder", "type": "wan"}, "_meta": {"title": "umt5-xxl text encoder"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": "$vae"}, "_meta": {"title": "Wan 2.2 VAE"}},
  "4": {"class_type": "LoadImage", "inputs": {"image": "$first_frame"}, "_meta": {"title": "First frame (the edited hook frame)"}},
  "5": {"class_type": "CLIPTextEncode", "inputs": {"text": "$prompt", "clip": ["2", 0]}, "_meta": {"title": "Positive"}},
  "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "$negative_prompt", "clip": ["2", 0]}, "_meta": {"title": "Negative"}},
  "7": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": {"vae": ["3", 0], "start_image": ["4", 0], "width": "$width", "height": "$height", "length": "$length", "batch_size": 1},
    "_meta": {"title": "Image-to-video latent (no last frame)"}
  },
  "8": {"class_type": "ModelSamplingSD3", "inputs": {"model": ["1", 0], "shift": "$shift"}, "_meta": {"title": "Shift"}},
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["8", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0],
      "seed": "$seed", "steps": "$steps", "cfg": "$cfg", "sampler_name": "$sampler", "scheduler": "$scheduler", "denoise": 1.0
    },
    "_meta": {"title": "Sampler"}
  },
  "10": {"class_type": "VAEDecode", "inputs": {"samples": ["9", 0], "vae": ["3", 0]}, "_meta": {"title": "Decode"}},
  "11": {"class_type": "CreateVideo", "inputs": {"images": ["10", 0], "fps": "$fps"}, "_meta": {"title": "Frames to video"}},
  "12": {"class_type": "SaveVideo", "inputs": {"video": ["11", 0], "filename_prefix": "$filename_prefix", "format": "mp4", "codec": "h264"}, "_meta": {"title": "Save (output/creative-forge/)"}}
}
